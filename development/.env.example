POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432

# MinIO object storage (docker-compose.yml services minio/minio-init). One shared
# private bucket (`jww`); features namespace their own objects under a folder.
MINIO_ROOT_USER=jww
MINIO_ROOT_PASSWORD=jww-development
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Optional image override (e.g. a local mirror when Docker Hub is unreachable).
# MinIO deleted its own Docker Hub images (minio/minio) in September 2026, so the
# default is the community-maintained pgsty/minio rebuild of the same binary.
# Defaults to pgsty/minio:RELEASE.2026-08-04T00-00-00Z.
# MINIO_IMAGE=registry.example.com/minio:RELEASE.2026-08-04T00-00-00Z

# Combined server + web-client container.
APP_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000
# Log a WARN when a readiness dependency takes at least this many milliseconds.
READINESS_LATENCY_WARN_MS=1000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:8000
JWT_SECRET_KEY=development-only-change-me
# Browser-visible API origin. Leave empty to call /api on the app's own origin.
WEB_API_BASE_URL=
# Optional; receipt extraction will fail when the development placeholder is used.
# OPENAI_API_KEY=sk-...
