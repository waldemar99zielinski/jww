POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432

# S3-compatible object storage (docker-compose.yml runs MinIO locally, but these
# names stay provider-agnostic: the same values work against AWS S3 or any other
# S3-compatible service). One shared private bucket (`jww`); features namespace
# their own objects under a folder.
STORAGE_BUCKET=jww
STORAGE_REGION=us-east-1
# Compose reaches the local MinIO container by service name. Point this at an
# external S3-compatible endpoint to use another provider with the app profile.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=jww
STORAGE_SECRET_ACCESS_KEY=jww-development
# Optional temporary session credential for providers that require one.
# STORAGE_SESSION_TOKEN=

# Local Compose-only settings: published ports and an optional image override.
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Optional image override (e.g. a local mirror when Docker Hub is unreachable).
# MinIO deleted its own Docker Hub images (minio/minio) in September 2026, so the
# default is the community-maintained pgsty/minio rebuild of the same binary.
# Defaults to pgsty/minio:RELEASE.2026-08-04T00-00-00Z.
# STORAGE_IMAGE=registry.example.com/minio:RELEASE.2026-08-04T00-00-00Z

# Combined server + web-client container. The Compose `app` profile is disabled
# by default; enable it with `--profile app` or uncomment the next line.
# COMPOSE_PROFILES=app
APP_PORT=8000
HTTP_CORS_ORIGINS=*
HTTP_MAX_BODY_BYTES=1048576
# Log a WARN when a readiness dependency takes at least this many milliseconds.
READINESS_LATENCY_WARN_MS=1000

JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME="Joint Wallet Watch"
WEBAUTHN_RP_ORIGINS=http://localhost:8000

LOG_LEVEL=debug
LOG_PRETTY=true

EXCHANGE_RATE_SYNC_ENABLED=false
EXCHANGE_RATE_SYNC_CRON="1 0 * * *"
EXCHANGE_RATE_SYNC_TZ=UTC
EXCHANGE_RATE_SYNC_TIMEOUT_SECONDS=60
EXCHANGE_RATE_SYNC_RUN_ON_START=false

FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_TIMEOUT_SECONDS=15

# Browser-visible API origin. Leave empty to call /api on the app's own origin.
WEB_API_BASE_URL=

# Required by the server; receipt extraction fails with the placeholder.
OPENAI_API_KEY=development-only
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=300

# Public URL where the extraction provider can reach this API.
PUBLIC_API_BASE_URL=http://localhost:8000
