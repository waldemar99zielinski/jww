VITE_API_BASE_URL=http://localhost:8000

# Uncomment to browse the whole app with in-memory mock data and auth bypassed —
# no backend needed. Restart the dev server after changing this.
# VITE_DESIGN_MODE=true

# Uncomment and set to a tunnel hostname (e.g. ngrok) to reach the dev server
# from another device. Restart the dev server after changing this.
# VITE_DEV_ALLOWED_HOST=your-tunnel-host.ngrok-free.dev
