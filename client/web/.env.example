# Backend origin. In dev the client calls the Vite server on the same origin and `/api` is
# proxied to this origin (see vite.config.ts), so no CORS configuration is needed.
VITE_API_BASE_URL=http://localhost:8001

# Override where the dev/preview proxy forwards `/api`. Defaults to VITE_API_BASE_URL above,
# then http://localhost:8001. Set this if the proxy and the built client need different origins.
# VITE_API_PROXY_TARGET=http://localhost:8001

# Uncomment to browse the whole app with in-memory mock data and auth bypassed —
# no backend needed. Restart the dev server after changing this.
# VITE_DESIGN_MODE=true

# ----------------------------------------------------------------------------------------------
# Reaching the dev/preview server from another device or through a tunnel
# ----------------------------------------------------------------------------------------------
# ngrok hostnames (*.ngrok-free.app, *.ngrok.app, *.ngrok.io, …) are allowed automatically.
# Set this only when using a different tunnel host. Restart the dev server after changing it.
# VITE_DEV_ALLOWED_HOST=your-tunnel-host.example.com

# HMR over an HTTPS tunnel must use the tunnel's port, not the local Vite port.
# Set 443 when reaching `npm run dev` through ngrok.
# VITE_DEV_HMR_CLIENT_PORT=443
