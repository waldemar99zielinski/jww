# --- internal/infrastructure/database.Config ---
# Plain "postgres://" DSN for pgx.
DATABASE_URL=postgres://user:pass@localhost:5432/finance

# --- internal/infrastructure/http_server.Config ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Comma-separated origins the client is served from
HTTP_CORS_ORIGINS=*
# Max request body size in bytes (Slowloris/oversized-body protection).
# NOTE: this cap does NOT apply to the two attachment-upload routes, which are
# deliberately size-unlimited — see the storage section and the design's risks.
HTTP_MAX_BODY_BYTES=1048576
# Optional Vite build directory. Empty keeps the process API-only; the image
# sets this to /app/web so the same process serves the SPA.
# WEB_STATIC_DIR=/app/web
# Browser-visible absolute HTTP(S) API origin emitted by /runtime-config.js at
# request time. Paths, credentials, queries, and fragments are rejected.
# Empty means same-origin and is the normal combined-container configuration.
# WEB_API_BASE_URL=

# --- internal/adapter/security.Config ---
# Required, no default — generate with: openssl rand -base64 48
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- internal/adapter/security/webauthn.Config ---
# Both required, no default — must exactly match the domain/origin serving
# the PWA, or every WebAuthn (Face ID/Touch ID/...) ceremony fails closed.
# RPID is the effective domain only (no scheme/port); RPOrigins is the
# comma-separated full origin(s) (scheme+host[:port]).
WEBAUTHN_RP_ID=change-me
WEBAUTHN_RP_DISPLAY_NAME=Joint Wallet Watch
WEBAUTHN_RP_ORIGINS=https://change-me

# --- utils/logger.Config ---
# One of: debug, info, warn, error
LOG_LEVEL=info
# true renders human-readable text logs instead of JSON
LOG_PRETTY=false

# --- internal/service/health.Config ---
# Per-dependency readiness latency threshold in milliseconds. An available
# dependency at or above this latency logs a WARN; unavailable dependencies
# always warn. Defaults to 1000ms.
READINESS_LATENCY_WARN_MS=1000

# --- internal/infrastructure/scheduler.Config ---
# Master switch for the daily exchange-rate sync. Off by default: turning it on
# makes the server fetch outbound rates once a day.
EXCHANGE_RATE_SYNC_ENABLED=false
# Standard 5-field cron spec (min hour dom mon dow), interpreted in
# EXCHANGE_RATE_SYNC_TZ. "1 0 * * *" = 00:01 daily; the job then fetches the
# previous calendar day, which is fully published by then.
EXCHANGE_RATE_SYNC_CRON=1 0 * * *
# IANA zone the cron spec is interpreted in; an invalid value fails startup.
EXCHANGE_RATE_SYNC_TZ=UTC
# Per-run context timeout for the whole job, in seconds.
EXCHANGE_RATE_SYNC_TIMEOUT_SECONDS=60
# Optional catch-up run at boot (safe/idempotent — runs upsert on the business date).
EXCHANGE_RATE_SYNC_RUN_ON_START=false

# --- internal/adapter/frankfurter.Config ---
# No API key required. Point elsewhere to self-host or stub in tests.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
FRANKFURTER_TIMEOUT_SECONDS=15

# --- internal/adapter/storage.Config (shared object storage; AWS SDK v2 / S3) ---
# A private, pre-created, S3-compatible bucket shared by any feature that stores
# blobs. Each feature namespaces its own objects under a folder in the key
# (transaction attachments use "transaction-attachments/<uuid>"), so this
# connection config has no per-feature prefix. The server never creates the
# bucket. These settings are provider-agnostic: point them at AWS S3, MinIO, or
# any other S3-compatible service. Local defaults target the development stack.
# Name of the pre-created private bucket.
STORAGE_BUCKET=jww
# Signing/endpoint region; local S3-compatible stores usually use us-east-1.
STORAGE_REGION=us-east-1
# Custom S3-compatible base URL. Leave empty on AWS to use the default resolver.
STORAGE_ENDPOINT=http://localhost:9000
# true for providers that need endpoint/bucket/key addressing (MinIO, most
# local stores). false uses virtual-hosted-style addressing.
STORAGE_FORCE_PATH_STYLE=true
# Optional static credential pair; set both or neither. Absent => default AWS
# credential chain. Never commit a real secret.
STORAGE_ACCESS_KEY_ID=jww
STORAGE_SECRET_ACCESS_KEY=jww-development
# Optional temporary session credential.
# STORAGE_SESSION_TOKEN=

# --- internal/adapter/openai.Config ---
# REQUIRED server-only secret. The API key for the vision provider; it never
# reaches the client.
OPENAI_API_KEY=sk-change-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=300

PUBLIC_API_BASE_URL=https://api.example.com
